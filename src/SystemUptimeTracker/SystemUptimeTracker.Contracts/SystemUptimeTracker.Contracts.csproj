<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>SystemUptimeTracker.Contracts</AssemblyName>
        <RootNamespace>SystemUptimeTracker.Contracts</RootNamespace>
        <Description>
            Versioned wire contracts for the System Uptime Tracker /api/v1 surface.
            This project owns every API DTO and must never reference ASP.NET Core,
            EF Core, or other runtime implementation packages (TASK-0102).
        </Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);1572;1573;1591</NoWarn>
        <Configurations>Debug;Release;Development;Testing;Staging;Production</Configurations>
    </PropertyGroup>

</Project>
